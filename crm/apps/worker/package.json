{
  "name": "@mabres/worker",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@mabres/db": "workspace:*",
    "@mabres/shared": "workspace:*",
    "@sentry/node": "^10.69.0",
    "bullmq": "^6.0.5",
    "ioredis": "^5.4.1",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
