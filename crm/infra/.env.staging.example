# Sprint 7 (infra) — variáveis do stack Docker Compose de STAGING.
# Copie para infra/.env.staging e preencha com valores reais (podem ser
# diferentes dos de produção — staging é um ambiente isolado, com seu
# próprio Postgres/Redis, nunca compartilha dados com produção).
# NUNCA commite infra/.env.staging.
#
# Uso: docker compose --env-file infra/.env.staging -p mabres-staging \
#        -f infra/docker-compose.yml up -d

# ---------------------------------------------------------------------------
# Domínio / TLS (Caddy)
# ---------------------------------------------------------------------------
# Ex.: staging.crm.mabres.com.br — subdomínio próprio, DNS separado do de produção.
DOMAIN=
ACME_EMAIL=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=mabres_staging
POSTGRES_PASSWORD=
POSTGRES_DB=mabres_crm_staging

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Aplicação (mesmas variáveis documentadas em ../.env.example)
# ---------------------------------------------------------------------------
APP_URL=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# Seed (Matheus/Brenda) é PERMITIDO em staging, mas nunca automático — é um
# passo manual (ver docs/ops/deploy.md). Preencha só se for rodar o seed.
SEED_MATHEUS_EMAIL=
SEED_MATHEUS_PASSWORD=
SEED_BRENDA_EMAIL=
SEED_BRENDA_PASSWORD=

# ---------------------------------------------------------------------------
# Observabilidade
# ---------------------------------------------------------------------------
SENTRY_DSN=

# Tag local das imagens buildadas por `docker compose build` — ver a mesma
# variável em .env.production.example para o que ela significa nesta fase
# (sem registry externo, o rollback padrão é git checkout + rebuild).
IMAGE_TAG=latest

IMAGE_TAG=latest
