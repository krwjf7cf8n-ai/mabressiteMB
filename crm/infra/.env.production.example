# Sprint 7 (infra) — variáveis do stack Docker Compose de PRODUÇÃO.
# Copie para infra/.env.production e preencha com valores reais.
# NUNCA commite infra/.env.production (já coberto por .gitignore/CI
# secrets-check — só arquivos *.example são permitidos no repositório).
#
# Uso: docker compose --env-file infra/.env.production -p mabres-production \
#        -f infra/docker-compose.yml up -d

# ---------------------------------------------------------------------------
# Domínio / TLS (Caddy)
# ---------------------------------------------------------------------------
# Domínio real de produção, ex.: crm.mabres.com.br — depende do domínio da
# Mabres estar registrado e com o DNS apontando para o IP do VPS.
DOMAIN=
# E-mail usado pela Let's Encrypt para avisos de expiração/revogação.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=mabres_prod
POSTGRES_PASSWORD=
POSTGRES_DB=mabres_crm_production

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Aplicação (mesmas variáveis documentadas em ../.env.example)
# ---------------------------------------------------------------------------
# Deve ser igual a https://{DOMAIN} depois que o DNS/TLS estiverem ativos.
APP_URL=
# Mínimo 32 caracteres — gere com, por exemplo, `openssl rand -base64 32`.
NEXTAUTH_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Observabilidade (opcional nesta fase — deixe vazio até existir conta Sentry)
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Tag local das imagens buildadas por `docker compose build` (ver
# docs/ops/rollback.md). Nesta fase as imagens são construídas localmente no
# próprio VPS a partir do código (não há registry externo) — o rollback
# padrão é git checkout da versão anterior + rebuild. Só vale a pena mudar
# este valor se você mesmo passar a taggear/reter imagens localmente por
# versão (ex.: IMAGE_TAG=$(git rev-parse --short HEAD) a cada deploy).
# ---------------------------------------------------------------------------
IMAGE_TAG=latest
