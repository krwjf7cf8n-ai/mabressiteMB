{
  "name": "mabres-crm",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @mabres/web dev",
    "worker": "pnpm --filter @mabres/worker dev",
    "build": "pnpm --filter @mabres/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @mabres/db generate",
    "db:migrate": "pnpm --filter @mabres/db migrate",
    "db:seed": "pnpm --filter @mabres/db seed"
  }
}
