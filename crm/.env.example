# Copie este arquivo para .env (ambiente local) ou .env.staging/.env.production
# conforme o ambiente e preencha com valores reais. NUNCA commite o .env real.
# NUNCA cole segredos reais em conversas, PRs ou issues.

# ---------------------------------------------------------------------------
# Núcleo da aplicação
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=
APP_URL=
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
REDIS_URL=

# Senhas dos usuários administradores criados pelo seed (Fase 2/MVP).
# Se deixadas vazias, o seed gera uma senha temporária e imprime no log local
# (nunca em produção — defina sempre antes de rodar seed fora do dev local).
SEED_MATHEUS_EMAIL=
SEED_MATHEUS_PASSWORD=
SEED_BRENDA_EMAIL=
SEED_BRENDA_PASSWORD=

# ---------------------------------------------------------------------------
# Feature flags de integrações externas — todas "false" até a fase correspondente
# ser aprovada e testada em sandbox. Ver docs/integration-plan.md.
# ---------------------------------------------------------------------------
FEATURE_META_LEAD_ADS=false
FEATURE_WHATSAPP_CLOUD_API=false
FEATURE_GOOGLE_OAUTH=false
FEATURE_EMOVEL_INTEGRATION=false

# ---------------------------------------------------------------------------
# Meta (Graph API / Lead Ads) — Fase 3
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# WhatsApp Business Platform (Cloud API) — Fase 4
# ---------------------------------------------------------------------------
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------
# Google (Gmail + Calendar, OAuth 2.0 por usuário) — Fase 5
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Inteligência artificial (módulo opcional, controle de custo obrigatório)
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_BRL=

# ---------------------------------------------------------------------------
# Armazenamento de arquivos (fotos, documentos)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------------------------------------------------------------------------
# E-mail transacional e observabilidade
# ---------------------------------------------------------------------------
EMAIL_FROM=
SENTRY_DSN=

# ---------------------------------------------------------------------------
# e-Móvel Brokers — manter vazio até confirmação oficial de API/XML pelo suporte.
# ---------------------------------------------------------------------------
EMOVEL_API_URL=
EMOVEL_API_KEY=
EMOVEL_CLIENT_ID=
EMOVEL_CLIENT_SECRET=
